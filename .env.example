# --- Database (Neon / Supabase / local PostgreSQL) ---
DATABASE_URL=postgres://trueform:trueform@localhost:5432/trueform

# --- Public URL of the site (used in emails and Paystack callbacks) ---
APP_URL=http://localhost:3000

# --- Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CURRENCY=GHS

# --- Cloudinary (cloudinary.com > Dashboard) - photos and videos ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (resend.com > API Keys) - transactional email ---
# Leave empty in development: emails are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="TrueForm Excellence <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=
